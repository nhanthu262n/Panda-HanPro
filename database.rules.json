{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('studentTeachers').child($uid).child(auth.uid).val() === true || root.child('users').child(auth.uid).child('role').val() === 'master_teacher')",
        ".write": "auth != null && auth.uid === $uid && (!data.exists() ? newData.child('role').val() in ['student', 'teacher', 'master_teacher'] : newData.child('role').val() === data.child('role').val())"
      }
    },

    "studentProgress": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('studentTeachers').child($uid).child(auth.uid).val() === true || root.child('users').child(auth.uid).child('role').val() === 'master_teacher')",
        ".write": "auth != null && auth.uid === $uid && newData.child('stats').isMap()"
      }
    },

    "quizResults": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('studentTeachers').child($uid).child(auth.uid).val() === true || root.child('users').child(auth.uid).child('role').val() === 'master_teacher')",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "streakTracking": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "curriculumDays": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() in ['teacher', 'master_teacher']"
    },

    "studentSchedules": {
      "$studentId": {
        ".read": "auth != null && (auth.uid === $studentId || root.child('studentTeachers').child($studentId).child(auth.uid).val() === true || root.child('users').child(auth.uid).child('role').val() === 'master_teacher')",
        ".write": "auth != null && (auth.uid === $studentId || root.child('users').child(auth.uid).child('role').val() in ['teacher', 'master_teacher'])"
      }
    },

    "reviewLogs": {
      "$studentId": {
        ".read": "auth != null && (auth.uid === $studentId || root.child('studentTeachers').child($studentId).child(auth.uid).val() === true || root.child('users').child(auth.uid).child('role').val() === 'master_teacher')",
        ".write": "auth != null && (auth.uid === $studentId || root.child('users').child(auth.uid).child('role').val() in ['teacher', 'master_teacher'])"
      }
    },

    "studentTeachers": {
      "$studentId": {
        ".read": "auth != null && (auth.uid === $studentId || root.child('users').child(auth.uid).child('role').val() in ['teacher', 'master_teacher'])",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'master_teacher'"
      }
    },

    "notifications": {
      "$studentId": {
        ".read": "auth != null && (auth.uid === $studentId || root.child('users').child(auth.uid).child('role').val() in ['teacher', 'master_teacher'])",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() in ['teacher', 'master_teacher']"
      }
    }
  }
}
