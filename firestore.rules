rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isTeacherOrMaster() {
      return signedIn() && userRole() in ['teacher', 'master_teacher'];
    }
    function isMaster() { return signedIn() && userRole() == 'master_teacher'; }
    function canAccessUser(uid) { return isSelf(uid) || isTeacherOrMaster(); }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid)
        && request.resource.data.role in ['student', 'teacher', 'master_teacher']
        && request.resource.data.email is string
        && request.resource.data.name is string;
      allow update: if isMaster()
        || (isTeacherOrMaster() && request.resource.data.role == resource.data.role)
        || (isSelf(uid) && request.resource.data.role == resource.data.role);
      allow delete: if isMaster();
    }

    match /progress/{uid} {
      allow read: if canAccessUser(uid);
      allow create, update: if isSelf(uid) && request.resource.data.stats is map;
      allow delete: if isSelf(uid) || isMaster();
    }
    match /studentProgress/{uid} {
      allow read: if canAccessUser(uid);
      allow create, update: if isSelf(uid);
      allow delete: if isSelf(uid) || isMaster();
    }
    match /quizResults/{uid} {
      allow read: if canAccessUser(uid);
      allow create, update: if isSelf(uid);
      allow delete: if isSelf(uid) || isMaster();
    }
    match /notifications/{notifId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isTeacherOrMaster());
      allow create: if isTeacherOrMaster() || isSelf(request.resource.data.userId);
      allow update: if signedIn() && (resource.data.userId == request.auth.uid || isTeacherOrMaster());
      allow delete: if signedIn() && (resource.data.userId == request.auth.uid || isMaster());
    }

    match /chats/{chatId} {
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants;
      allow read, delete: if signedIn()
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants;
      allow update: if signedIn()
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;

      match /messages/{messageId} {
        allow read, create, update, delete: if signedIn()
          && exists(/databases/$(database)/documents/chats/$(chatId))
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }

    match /broadcasts/{broadcastId} {
      allow read: if signedIn();
      allow create, update, delete: if isTeacherOrMaster();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
